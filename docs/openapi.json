{"openapi":"3.0.0","paths":{"/api/auth/register":{"post":{"operationId":"AuthController_register","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateUserDto"}}}},"responses":{"201":{"description":""}},"tags":["Auth"]}},"/api/auth/login":{"post":{"operationId":"AuthController_login","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginDto"}}}},"responses":{"200":{"description":""}},"tags":["Auth"]}},"/api/users/me":{"get":{"operationId":"UsersController_getProfile","parameters":[],"responses":{"200":{"description":""}},"tags":["Users"]}},"/api/suppliers":{"post":{"description":"Creates a new supplier profile. For SUPPLIER role users, profile automatically binds to their authenticated user account. ADMIN and SUPERVISOR can provide a target userId in the request body.","operationId":"SuppliersController_create","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateSupplierDto"}}}},"responses":{"201":{"description":"Supplier profile created successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SupplierResponseDto"}}}},"400":{"description":"Validation error in request payload"},"401":{"description":"Unauthorized - missing or invalid JWT token"},"404":{"description":"Target user not found (when specified by admin)"},"409":{"description":"Conflict - User already has a supplier profile (1:0..1 cardinality violated)"}},"security":[{"bearer":[]}],"summary":"Create supplier profile","tags":["Suppliers"]},"get":{"description":"Retrieves all supplier profiles in the system. Restricted to ADMIN and SUPERVISOR roles.","operationId":"SuppliersController_findAll","parameters":[],"responses":{"200":{"description":"List of all supplier profiles","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SupplierResponseDto"}}}}},"401":{"description":"Unauthorized - missing or invalid JWT token"},"403":{"description":"Forbidden - SUPPLIER role users cannot access the global supplier list"}},"security":[{"bearer":[]}],"summary":"List all suppliers","tags":["Suppliers"]}},"/api/suppliers/me":{"get":{"description":"Retrieves the supplier profile bound to the currently authenticated user.","operationId":"SuppliersController_getMyProfile","parameters":[],"responses":{"200":{"description":"Supplier profile of current user","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SupplierResponseDto"}}}},"401":{"description":"Unauthorized - missing or invalid JWT token"},"404":{"description":"Not found - current user does not have an associated supplier profile"}},"security":[{"bearer":[]}],"summary":"Get current user supplier profile","tags":["Suppliers"]}},"/api/suppliers/{id}":{"get":{"description":"Retrieves a specific supplier profile. ADMIN and SUPERVISOR can access any supplier; SUPPLIER users may only access their own profile.","operationId":"SuppliersController_findOne","parameters":[{"name":"id","required":true,"in":"path","description":"Supplier UUID","schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"description":"Supplier profile details","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SupplierResponseDto"}}}},"401":{"description":"Unauthorized - missing or invalid JWT token"},"403":{"description":"Forbidden - SUPPLIER cannot view other suppliers profiles"},"404":{"description":"Supplier not found"}},"security":[{"bearer":[]}],"summary":"Get supplier profile by ID","tags":["Suppliers"]},"patch":{"description":"Updates supplier profile information. SUPPLIER role users can only update their own profile. ADMIN and SUPERVISOR can update any profile.","operationId":"SuppliersController_update","parameters":[{"name":"id","required":true,"in":"path","description":"Supplier UUID","schema":{"format":"uuid","type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateSupplierDto"}}}},"responses":{"200":{"description":"Supplier profile updated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SupplierResponseDto"}}}},"400":{"description":"Validation error in update payload"},"401":{"description":"Unauthorized - missing or invalid JWT token"},"403":{"description":"Forbidden - SUPPLIER cannot update other suppliers profiles"},"404":{"description":"Supplier not found"}},"security":[{"bearer":[]}],"summary":"Update supplier profile","tags":["Suppliers"]},"delete":{"description":"Deletes a supplier profile and cascades to associated products. Restricted to ADMIN and SUPERVISOR roles.","operationId":"SuppliersController_remove","parameters":[{"name":"id","required":true,"in":"path","description":"Supplier UUID","schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"description":"Supplier profile deleted successfully"},"401":{"description":"Unauthorized - missing or invalid JWT token"},"403":{"description":"Forbidden - SUPPLIER role users cannot delete supplier profiles"},"404":{"description":"Supplier not found"}},"security":[{"bearer":[]}],"summary":"Delete supplier profile","tags":["Suppliers"]}},"/api/products":{"post":{"description":"Creates a new product. For SUPPLIER role users, product is auto-bound to their supplier profile. ADMIN and SUPERVISOR must provide a valid supplierId.","operationId":"ProductsController_create","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateProductDto"}}}},"responses":{"201":{"description":"Product created successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductResponseDto"}}}},"400":{"description":"Validation error in request payload or missing supplierId for admin"},"401":{"description":"Unauthorized - missing or invalid JWT token"},"403":{"description":"Forbidden - Supplier profile must be created before adding products"},"404":{"description":"Supplier not found (when specified by admin)"}},"security":[{"bearer":[]}],"summary":"Create product","tags":["Products"]},"get":{"description":"Retrieves products. ADMIN and SUPERVISOR see all products or filter by supplierId. SUPPLIER role users only see products belonging to their own supplier profile.","operationId":"ProductsController_findAll","parameters":[{"name":"supplierId","required":false,"in":"query","description":"Filter products by supplier UUID (ADMIN and SUPERVISOR only)","schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"description":"List of accessible products","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ProductResponseDto"}}}}},"400":{"description":"Validation error - invalid supplierId UUID format"},"401":{"description":"Unauthorized - missing or invalid JWT token"}},"security":[{"bearer":[]}],"summary":"List products","tags":["Products"]}},"/api/products/{id}":{"get":{"description":"Retrieves details of a specific product. ADMIN and SUPERVISOR can view any product. SUPPLIER role users can only view their own products.","operationId":"ProductsController_findOne","parameters":[{"name":"id","required":true,"in":"path","description":"Product UUID","schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"description":"Product details","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductResponseDto"}}}},"401":{"description":"Unauthorized - missing or invalid JWT token"},"403":{"description":"Forbidden - SUPPLIER cannot view products of other suppliers"},"404":{"description":"Product not found"}},"security":[{"bearer":[]}],"summary":"Get product by ID","tags":["Products"]},"patch":{"description":"Updates product details. SUPPLIER role users can only update their own products. ADMIN and SUPERVISOR can update any product.","operationId":"ProductsController_update","parameters":[{"name":"id","required":true,"in":"path","description":"Product UUID","schema":{"format":"uuid","type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProductDto"}}}},"responses":{"200":{"description":"Product updated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductResponseDto"}}}},"400":{"description":"Validation error in request payload"},"401":{"description":"Unauthorized - missing or invalid JWT token"},"403":{"description":"Forbidden - SUPPLIER cannot update products of other suppliers"},"404":{"description":"Product not found"}},"security":[{"bearer":[]}],"summary":"Update product","tags":["Products"]},"delete":{"description":"Deletes a product. SUPPLIER role users can only delete their own products. ADMIN and SUPERVISOR can delete any product.","operationId":"ProductsController_remove","parameters":[{"name":"id","required":true,"in":"path","description":"Product UUID","schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"description":"Product deleted successfully"},"401":{"description":"Unauthorized - missing or invalid JWT token"},"403":{"description":"Forbidden - SUPPLIER cannot delete products of other suppliers"},"404":{"description":"Product not found"}},"security":[{"bearer":[]}],"summary":"Delete product","tags":["Products"]}},"/api/questionnaires":{"post":{"description":"Creates a new questionnaire in DRAFT status. Only ADMIN and SUPERVISOR.","operationId":"QuestionnairesController_create","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateQuestionnaireDto"}}}},"responses":{"201":{"description":"Questionnaire created successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionnaireResponseDto"}}}}},"security":[{"bearer":[]}],"summary":"Create a questionnaire","tags":["Questionnaires"]},"get":{"description":"Lists questionnaires. ADMIN/SUPERVISOR can view all questionnaires; SUPPLIER can only view published or assigned questionnaires.","operationId":"QuestionnairesController_findAll","parameters":[{"name":"status","required":false,"in":"query","description":"Filter by questionnaire status (DRAFT, PUBLISHED, ARCHIVED)","schema":{"enum":["DRAFT","PUBLISHED","ARCHIVED"],"type":"string"}}],"responses":{"200":{"description":"List of questionnaires","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/QuestionnaireResponseDto"}}}}}},"security":[{"bearer":[]}],"summary":"List questionnaires","tags":["Questionnaires"]}},"/api/questionnaires/{id}":{"get":{"description":"Retrieves questionnaire details including questions and options.","operationId":"QuestionnairesController_findOne","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Questionnaire details","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionnaireResponseDto"}}}},"403":{"description":"Forbidden for supplier if unpublished"},"404":{"description":"Questionnaire not found"}},"security":[{"bearer":[]}],"summary":"Get questionnaire details","tags":["Questionnaires"]},"patch":{"description":"Updates questionnaire metadata or status. Only ADMIN and SUPERVISOR.","operationId":"QuestionnairesController_update","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateQuestionnaireDto"}}}},"responses":{"200":{"description":"Questionnaire updated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionnaireResponseDto"}}}},"404":{"description":"Questionnaire not found"}},"security":[{"bearer":[]}],"summary":"Update questionnaire","tags":["Questionnaires"]},"delete":{"description":"Deletes a questionnaire. Only ADMIN and SUPERVISOR.","operationId":"QuestionnairesController_remove","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Questionnaire deleted successfully"},"404":{"description":"Questionnaire not found"}},"security":[{"bearer":[]}],"summary":"Delete questionnaire","tags":["Questionnaires"]}},"/api/questionnaires/{id}/versions":{"post":{"description":"Clones the questionnaire and its questions/options into a new DRAFT questionnaire with incremented version number.","operationId":"QuestionnairesController_createVersion","parameters":[{"name":"id","required":true,"in":"path","description":"Parent questionnaire UUID","schema":{"type":"string"}}],"responses":{"201":{"description":"New questionnaire version created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionnaireResponseDto"}}}},"404":{"description":"Parent questionnaire not found"}},"security":[{"bearer":[]}],"summary":"Create a new version of questionnaire","tags":["Questionnaires"]}},"/api/questionnaires/{id}/questions":{"post":{"description":"Creates a question within the questionnaire.","operationId":"QuestionnairesController_addQuestion","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateQuestionDto"}}}},"responses":{"201":{"description":"Question created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionResponseDto"}}}}},"security":[{"bearer":[]}],"summary":"Add question to questionnaire","tags":["Questionnaires"]}},"/api/questionnaires/{id}/questions/{questionId}":{"patch":{"description":"Updates question details.","operationId":"QuestionnairesController_updateQuestion","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}},{"name":"questionId","required":true,"in":"path","description":"Question UUID","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateQuestionDto"}}}},"responses":{"200":{"description":"Question updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionResponseDto"}}}}},"security":[{"bearer":[]}],"summary":"Update question","tags":["Questionnaires"]},"delete":{"description":"Deletes a question and its associated options.","operationId":"QuestionnairesController_deleteQuestion","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}},{"name":"questionId","required":true,"in":"path","description":"Question UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Question deleted"}},"security":[{"bearer":[]}],"summary":"Delete question","tags":["Questionnaires"]}},"/api/questionnaires/{id}/questions/{questionId}/options":{"post":{"description":"Adds an option to a single-choice question, optionally specifying a followUpQuestionId from the same questionnaire.","operationId":"QuestionnairesController_addOption","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}},{"name":"questionId","required":true,"in":"path","description":"Question UUID","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateOptionDto"}}}},"responses":{"201":{"description":"Option created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionOptionResponseDto"}}}},"400":{"description":"Invalid follow-up question (e.g. from another questionnaire)"}},"security":[{"bearer":[]}],"summary":"Add option to question","tags":["Questionnaires"]}},"/api/questionnaires/{id}/questions/{questionId}/options/{optionId}":{"patch":{"description":"Updates option label, value, order, or follow-up question link.","operationId":"QuestionnairesController_updateOption","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}},{"name":"questionId","required":true,"in":"path","description":"Question UUID","schema":{"type":"string"}},{"name":"optionId","required":true,"in":"path","description":"Option UUID","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateOptionDto"}}}},"responses":{"200":{"description":"Option updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionOptionResponseDto"}}}}},"security":[{"bearer":[]}],"summary":"Update question option","tags":["Questionnaires"]},"delete":{"description":"Deletes a question option.","operationId":"QuestionnairesController_deleteOption","parameters":[{"name":"id","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}},{"name":"questionId","required":true,"in":"path","description":"Question UUID","schema":{"type":"string"}},{"name":"optionId","required":true,"in":"path","description":"Option UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Option deleted"}},"security":[{"bearer":[]}],"summary":"Delete question option","tags":["Questionnaires"]}},"/api/assignments":{"post":{"description":"Assigns a questionnaire to a supplier, optionally targeting a specific product belonging to that supplier. Triggers in-app notification. Only ADMIN and SUPERVISOR.","operationId":"AssignmentsController_create","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAssignmentDto"}}}},"responses":{"201":{"description":"Assignment created successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignmentResponseDto"}}}},"400":{"description":"Product does not belong to supplier"},"409":{"description":"Duplicate assignment already exists"}},"security":[{"bearer":[]}],"summary":"Assign questionnaire to supplier","tags":["Assignments & Responses"]},"get":{"description":"Lists assignments. SUPPLIER users only see their own assignments; ADMIN and SUPERVISOR can filter across all suppliers, products, and questionnaires.","operationId":"AssignmentsController_findAll","parameters":[{"name":"supplierId","required":false,"in":"query","schema":{"type":"string"}},{"name":"productId","required":false,"in":"query","schema":{"type":"string"}},{"name":"questionnaireId","required":false,"in":"query","schema":{"type":"string"}},{"name":"status","required":false,"in":"query","schema":{"enum":["PENDING","IN_PROGRESS","SUBMITTED"],"type":"string"}}],"responses":{"200":{"description":"List of assignments","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AssignmentResponseDto"}}}}}},"security":[{"bearer":[]}],"summary":"List questionnaire assignments","tags":["Assignments & Responses"]}},"/api/assignments/questionnaire/{questionnaireId}/responses":{"get":{"description":"Essential response retrieval for supervisors and admins to review all submitted answers, suppliers, and product information for a given questionnaire (Option B).","operationId":"AssignmentsController_getResponses","parameters":[{"name":"questionnaireId","required":true,"in":"path","description":"Questionnaire UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"List of submitted responses and structured answer data"}},"security":[{"bearer":[]}],"summary":"Inspect submitted responses for a questionnaire","tags":["Assignments & Responses"]}},"/api/assignments/{id}":{"get":{"description":"Retrieves assignment details, including full questionnaire questions, options, and any recorded answers.","operationId":"AssignmentsController_findOne","parameters":[{"name":"id","required":true,"in":"path","description":"Assignment UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Assignment details with answers","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignmentResponseDto"}}}},"403":{"description":"Forbidden for another supplier"},"404":{"description":"Assignment not found"}},"security":[{"bearer":[]}],"summary":"Get assignment details","tags":["Assignments & Responses"]},"delete":{"description":"Deletes a questionnaire assignment. Only ADMIN and SUPERVISOR.","operationId":"AssignmentsController_remove","parameters":[{"name":"id","required":true,"in":"path","description":"Assignment UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Assignment deleted successfully"}},"security":[{"bearer":[]}],"summary":"Delete assignment","tags":["Assignments & Responses"]}},"/api/assignments/{id}/status":{"patch":{"description":"Manually updates the assignment status. Only ADMIN and SUPERVISOR.","operationId":"AssignmentsController_updateStatus","parameters":[{"name":"id","required":true,"in":"path","description":"Assignment UUID","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateAssignmentStatusDto"}}}},"responses":{"200":{"description":"Assignment status updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignmentResponseDto"}}}}},"security":[{"bearer":[]}],"summary":"Update assignment status","tags":["Assignments & Responses"]}},"/api/assignments/{id}/answers":{"post":{"description":"Saves or updates answers for the questionnaire assignment. Automatically sets status to IN_PROGRESS. Rejects if the assignment is already SUBMITTED.","operationId":"AssignmentsController_saveAnswers","parameters":[{"name":"id","required":true,"in":"path","description":"Assignment UUID","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SaveAnswersDto"}}}},"responses":{"200":{"description":"Answers saved successfully","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AnswerResponseDto"}}}}},"400":{"description":"Assignment is locked or question does not belong to questionnaire"}},"security":[{"bearer":[]}],"summary":"Save answers for an assignment","tags":["Assignments & Responses"]}},"/api/assignments/{id}/submit":{"post":{"description":"Finalizes and submits the questionnaire assignment, locking the answers from further modifications. Notifies the questionnaire creator.","operationId":"AssignmentsController_submit","parameters":[{"name":"id","required":true,"in":"path","description":"Assignment UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Assignment submitted and locked successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignmentResponseDto"}}}},"400":{"description":"Already submitted or missing required answers"}},"security":[{"bearer":[]}],"summary":"Submit questionnaire responses","tags":["Assignments & Responses"]}},"/api/assignments/{id}/reopen":{"post":{"description":"Re-opens a submitted assignment back to IN_PROGRESS status, unlocking answers for resubmission. Only ADMIN and SUPERVISOR.","operationId":"AssignmentsController_reopen","parameters":[{"name":"id","required":true,"in":"path","description":"Assignment UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Assignment re-opened successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignmentResponseDto"}}}}},"security":[{"bearer":[]}],"summary":"Re-open submitted assignment","tags":["Assignments & Responses"]}},"/api/assignments/{id}/ai-assessment":{"post":{"description":"Analyzes submitted questionnaire answers using AI and returns an indicative score (0-100), rating label, concise summary, concerns, and recommendations. Requires the assignment to be in SUBMITTED status. Only ADMIN and SUPERVISOR.","operationId":"AssignmentsController_generateAiAssessment","parameters":[{"name":"id","required":true,"in":"path","description":"Submitted assignment UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"AI assessment generated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AiAssessmentResponseDto"}}}},"400":{"description":"Assignment is not in SUBMITTED status"},"401":{"description":"Unauthorized"},"403":{"description":"Forbidden - only ADMIN and SUPERVISOR"},"404":{"description":"Assignment not found"},"502":{"description":"Bad Gateway - AI provider error or malformed response"},"503":{"description":"Service Unavailable - AI service is not configured"}},"security":[{"bearer":[]}],"summary":"Generate AI assessment for a submitted assignment","tags":["Assignments & Responses"]}},"/api/notifications":{"get":{"description":"Retrieves notifications received by the authenticated user, optionally filtered to unread only.","operationId":"NotificationsController_getMyNotifications","parameters":[{"name":"unreadOnly","required":false,"in":"query","description":"If true, returns only unread notifications","schema":{"type":"boolean"}}],"responses":{"200":{"description":"Notifications list","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NotificationResponseDto"}}}}}},"security":[{"bearer":[]}],"summary":"Get notifications for current user","tags":["Notifications"]}},"/api/notifications/{id}/read":{"patch":{"description":"Marks a specific notification belonging to the current user as read.","operationId":"NotificationsController_markAsRead","parameters":[{"name":"id","required":true,"in":"path","description":"Notification UUID","schema":{"type":"string"}}],"responses":{"200":{"description":"Notification marked as read","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotificationResponseDto"}}}},"403":{"description":"Forbidden"},"404":{"description":"Notification not found"}},"security":[{"bearer":[]}],"summary":"Mark a notification as read","tags":["Notifications"]}},"/api/notifications/read-all":{"patch":{"description":"Marks all unread notifications for the current user as read.","operationId":"NotificationsController_markAllAsRead","parameters":[],"responses":{"200":{"description":"All notifications marked as read"}},"security":[{"bearer":[]}],"summary":"Mark all notifications as read","tags":["Notifications"]}}},"info":{"title":"Supplier Monitoring & Questionnaire System","description":"API for managing suppliers, questionnaires, and responses","version":"1.0","contact":{}},"tags":[],"servers":[],"components":{"securitySchemes":{"bearer":{"scheme":"bearer","bearerFormat":"JWT","type":"http"}},"schemas":{"CreateUserDto":{"type":"object","properties":{}},"LoginDto":{"type":"object","properties":{}},"CreateSupplierDto":{"type":"object","properties":{"companyName":{"type":"string","description":"Name of the supplier company","example":"Acme Industrial Solutions"},"description":{"type":"string","description":"Detailed description of company capabilities and services","example":"Leading manufacturer of high-precision sensors and electronic components"},"address":{"type":"string","description":"Physical address of the supplier headquarters or facility","example":"123 Innovation Way, Tech Park, Austin, TX 78759"},"phone":{"type":"string","description":"Primary contact telephone number","example":"+1-512-555-0199"},"userId":{"type":"string","description":"Target User UUID to bind to the supplier profile (ADMIN and SUPERVISOR only; ignored for SUPPLIER role)","example":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11","format":"uuid"}},"required":["companyName"]},"SupplierUserSummaryDto":{"type":"object","properties":{"id":{"type":"string","example":"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11","format":"uuid"},"email":{"type":"string","example":"supplier@example.com"},"firstName":{"type":"string","example":"John"},"lastName