# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://quaudit:quaudit_secret@localhost:5432/quaudit?schema=public
TEST_DATABASE_URL=postgresql://quaudit:quaudit_secret@localhost:5432/quaudit_test?schema=public

# JWT
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRATION=24h

# Seed Accounts
SEED_SUPERVISOR_EMAIL=supervisor@quaudit.com
SEED_SUPERVISOR_PASSWORD=Supervisor@123456
SEED_SUPERVISOR_FIRST_NAME=Audit
SEED_SUPERVISOR_LAST_NAME=Supervisor
SEED_SUPPLIER_EMAIL=supplier@quaudit.com
SEED_SUPPLIER_PASSWORD=Supplier@123456

# AI Provider Configuration
AI_API_KEY=your-ai-api-key-here
AI_BASE_URL=https://1xai.ir/v1
AI_MODEL=gpt-4o-mini
